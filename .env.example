# Copy to ".env" and fill in REAL values. Never commit a real .env.

# REQUIRED — long random secret. Generate one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The WordPress plugin sends this as: Authorization: Bearer <API_KEY>
API_KEY=change-me-to-a-long-random-key

# REQUIRED — public URL of this backend, NO trailing slash.
# This is the "API Base URL" you paste into the WordPress plugin settings.
# Example: https://api.yttomp4.in.net
PUBLIC_BASE_URL=https://api.yourdomain.com

# WordPress site(s) allowed to call the API from a browser, comma-separated.
# The plugin calls the backend server-to-server, so "*" is acceptable,
# but listing your site is tighter.
CORS_ORIGINS=https://yttomp4.in.net

# Optional tuning (defaults shown).
# DOWNLOAD_DIR=downloads
# MAX_DURATION_SECONDS=3600
# MAX_FILE_AGE_HOURS=24
# MAX_CONCURRENT_JOBS=3
# RATE_LIMIT_CONVERT_PER_MIN=30
# RATE_LIMIT_STATUS_PER_MIN=120
